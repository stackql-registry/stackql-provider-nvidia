# Live smoke-test credentials (copy to .env - gitignored - and fill in).
# `make smoke` and the other smoke targets source .env when present. Never
# point this at a production organization.
#
# The variable names are the ones the NVIDIA Terraform provider
# (NVIDIA/terraform-provider-ngc) reads, so one environment serves both.

# NGC Personal API Key (NGC console -> Setup -> Generate Personal API Key).
# Service scopes needed: Private Registry for the registry service, and
# Cloud Functions at the ORGANIZATION level for the nvcf_* services (a key
# with a team-level Cloud Functions role does not work with NVCF - NVIDIA's
# own documentation warns about this). The provider sends it as
# `Authorization: Bearer`.
NGC_API_KEY=nvapi-...

# NGC organization name (the org id shown under Organization -> Setup, e.g.
# 0123456789ab). Resolves the org_name server variable so org-scoped queries
# (registry, orgs) need no WHERE org_name clause; the smoke suite runs
# against this org.
NGC_ORG=0123456789ab

# Optional: a team in the org. Only used by the smoke suite to exercise the
# *_by_team registry methods; leave unset to skip them.
# NGC_TEAM=

# Optional, `make smoke-nvcf` only: the container image the gated deploy
# lifecycle deploys (an image in this org's private registry - the NVCF
# echo sample or any small HTTP container). Without it the deploy step is
# skipped with a notice; the undeployed function lifecycle (free) still
# runs whenever Cloud Functions is enabled for the org. GPU minutes on the
# deployed function are billable - the lifecycle uses the smallest instance
# type of the first cluster group, stays well under $1, and always tears
# down.
# NVCF_SMOKE_CONTAINER_IMAGE=nvcr.io/0123456789ab/echo:latest
